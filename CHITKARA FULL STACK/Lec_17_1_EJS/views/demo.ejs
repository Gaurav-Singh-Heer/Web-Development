<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">

    <div class="container text-center mt-5">
        <h1>Welcome, <%= user.name %> 🙋‍♀️</h1>

        <% if (user.isAdmin) { %>
            <p class="alert alert-success">You have <strong>admin</strong> privileges.</p>
        <% } else { %>
            <p class="alert alert-warning">You are a <strong>regular</strong> user.</p>
        <% } %>
    </div>

</body>
</html>
