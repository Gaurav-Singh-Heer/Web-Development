<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
    
</head>
<body>
    <%- include('./partials/nav') %>

    <% if (blog) { %>
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageURL %>" width="150px" height="100px">
        <p><%= blog.body %></p>
        <div class="container mt-4">
            <img src="<%= blog.createdBy.profileImageURL %>" width="50px">
            <h2 style="display: inline;">~By:-</h2><h3 style="display: inline; margin-left: 5px;"><%= blog.createdBy.fullName %></h3>
        </div>
    <% } else { %>
        <p>Blog not found.</p>
    <% } %>
    


    <% if (locals.user) { %>
        <div class="container mt-3">
            <h1>Comments (<%= comments.length %>)</h1>
            <!-- <form action="/comment/:blogId" method="post"> --> <!-- Copy Form From Signin.ejs-->
            <form action="/blog/comment/<%= blog._id%>" method="post">   <!-- Copy Form From Signin.ejs-->
                <div class="mb-3">
                    <input type="text" class="form-control" name="content" placeholder="Enter your comment">
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Add</button>
            </form>
        </div>
    <% } %>
    <div class="container mt-3">  <!--Comments must be visible to user without Login-->
        <% comments.forEach(comment => { %>
            <div>
                <img src="<%=comment.createdBy.profileImageURL%>" width="50px" alt="">
                <h3 style="display: inline; margin-left: 5px;"><%= comment.createdBy.fullName %></h3>
                <pre><%= comment.content %></pre>
            </div>
        <% }); %>
    </div>
        
    <%- include('./partials/script') %>
</body>
</html>