<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    <h1>Hey From Server</h1>
    <h3>Hey Again</h3>
    <% urls.forEach(url => { %>
        <li><%= url.shortId %></li>
    <% }) %>
    <% urls.forEach(url => { %>
        <li><%= url.shortId %> - <%= url.redirectURL %> - Visits: <%= url.visitHistory.length %></li>
    <% }) %>
</body>
</html>