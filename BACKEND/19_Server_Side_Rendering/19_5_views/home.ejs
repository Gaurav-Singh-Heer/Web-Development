<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    <h1>URL Shortener</h1>
    <% if (locals.id) { %>
        <p>URL Generated: http://localhost:8001/<%= id %></p>
    <% } %>
    <div>
        <form method="POST" action="/url">       <!--action means to Post at which route. app.use("/url" , urlRoute); then at urlRoute we have "/" so only /url-->
            <label>Enter Your Original URL</label>
            <input type="text" name="url" placeholder="https://example.com"> <!--at at url.js routes at handleGenerateNewShortURL or at url.js controllers handleGenerateNewShortURL we are sending only url. So,name="url"-->
            <button type="submit">Generate</button>
        </form>
    </div>
</body>
</html>